function 取authCookie(request) {
	const cookies = request.headers.get('Cookie') || '';
	return cookies.split(';').find(c => c.trim().startsWith('auth='))?.split('=')[1];
}

async function 发送TG文本(env, html) {
	const TG_TXT = await env.KV.get('tg.json');
	if (!TG_TXT) return { ok: false, error: '未配置 tg.json' };
	const TG = JSON.parse(TG_TXT);
	if (!TG?.BotToken || !TG?.ChatID) return { ok: false, error: 'BotToken / ChatID 不完整' };
	try {
		const r = await fetch(`https://api.telegram.org/bot${TG.BotToken}/sendMessage`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ chat_id: TG.ChatID, parse_mode: 'HTML', text: html, disable_web_page_preview: true }),
		});
		const j = await r.json().catch(() => ({}));
		return r.ok && j?.ok ? { ok: true } : { ok: false, error: j?.description || ('HTTP ' + r.status) };
	} catch (e) { return { ok: false, error: e.message }; }
}


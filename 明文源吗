export default {
	async fetch(request, env, ctx) {
		// 1) WebSocket 升级 → Grain 转发内核
		if ((request.headers.get('Upgrade') || '').toLowerCase() === 'websocket') return ws(request);

		// 2) 请求期全局
		const url = new URL(request.url);
		UA = request.headers.get('User-Agent') || 'null';
		访问IP = request.headers.get('CF-Connecting-IP') || request.headers.get('True-Client-IP') || request.headers.get('X-Real-IP') || request.headers.get('X-Forwarded-For') || '未知IP';
		管理员密码 = env.ADMIN || env.admin || env.PASSWORD || env.password || env.pswd || env.TOKEN || env.KEY || env.UUID || env.uuid;
		加密秘钥 = env.KEY || '勿动此默认密钥，有需求请自行通过添加变量KEY进行修改';
		const uuidRegex = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$/;
		const envUUID = env.UUID || env.uuid;
		const userIDMD5 = await MD5MD5(管理员密码 + 加密秘钥);
		userID = (envUUID && uuidRegex.test(envUUID)) ? envUUID.toLowerCase() : [userIDMD5.slice(0, 8), userIDMD5.slice(8, 12), '4' + userIDMD5.slice(13, 16), '8' + userIDMD5.slice(17, 20), userIDMD5.slice(20)].join('-');
		hosts = env.HOST ? (await 整理成数组(env.HOST)).map(h => h.toLowerCase().replace(/^https?:\/\//, '').split('/')[0].split(':')[0]) : [url.hostname];
		host = hosts[0];
		访问路径 = url.pathname.slice(1).toLowerCase();
		const [本机标识头值, 本机标识键值] = 获取本机标识(userID);
		本机标识头 = 本机标识头值; 本机标识键 = 本机标识键值;
		默认反代IP = (`${request.cf?.colo || 'HKG'}.${特征码字典[0]}.${特征码字典[1]}SsSs.nEt`).toLowerCase(); 默认反代兜底 = true;
		if (env.PROXYIP) { const proxyIPs = await 整理成数组(env.PROXYIP); 默认反代IP = proxyIPs[Math.floor(Math.random() * proxyIPs.length)]; 默认反代兜底 = false; }
		if (缓存SOCKS5白名单 === null) { if (env.GO2SOCKS5) SOCKS5白名单 = [...new Set(SOCKS5白名单.concat(await 整理成数组(env.GO2SOCKS5)))]; 缓存SOCKS5白名单 = SOCKS5白名单; } else SOCKS5白名单 = 缓存SOCKS5白名单;

		// 3) 非管理路由
		if (url.protocol === 'http:') return Response.redirect(url.href.replace(`http://${url.hostname}`, `https://${url.hostname}`), 301);
		if (!管理员密码) return new Response('未配置管理员密码（环境变量 ADMIN / PASSWORD / TOKEN / UUID 之一）', { status: 404 });
		if (!env.KV || typeof env.KV.get !== 'function') return new Response('未绑定 KV 命名空间（binding 名：KV）', { status: 404 });

		const 区分大小写访问路径 = url.pathname.slice(1);
		// 快速订阅：以加密秘钥为路径
		if (区分大小写访问路径 === 加密秘钥 && 加密秘钥 !== '勿动此默认密钥，有需求请自行通过添加变量KEY进行修改') {
			const params = new URLSearchParams(url.search);
			params.set('token', await MD5MD5(host + userID));
			return new Response('重定向中...', { status: 302, headers: { 'Location': `/sub?${params.toString()}` } });
		}
		if (访问路径 === 'login') return 处理登录(request, env, url);
		if (访问路径 === 'admin' || 访问路径.startsWith('admin/')) return 处理管理(request, env, url, ctx);
		if (访问路径 === 'logout' || uuidRegex.test(访问路径)) {
			const 响应 = new Response('重定向中...', { status: 302, headers: { 'Location': '/login' } });
			响应.headers.set('Set-Cookie', 'auth=; Path=/; Max-Age=0; HttpOnly');
			return 响应;
		}
		if (访问路径 === 'sub') return 处理订阅(request, env, ctx, url);
		if (访问路径 === 'locations') {
			const authCookie = 取authCookie(request);
			if (authCookie && authCookie == await MD5MD5(UA + 加密秘钥 + 管理员密码)) return fetch(new Request('https://speed.cloudflare.com/locations', { headers: { 'Referer': 'https://speed.cloudflare.com/' } }));
		}
		if (访问路径 === 'robots.txt') return new Response('User-agent: *\nDisallow: /', { status: 200, headers: { 'Content-Type': 'text/plain; charset=UTF-8' } });

		// 4) 兜底伪装页
		return 伪装页(request, env, url);
	}
};
